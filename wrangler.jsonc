{
  "name": "my-agent",
  "main": "src/server.ts",
  // Set this to today's date
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  // Comma-separated origins allowed in Clerk session JWT `azp` claims.
  // Add your custom domain here before production deploy, e.g.:
  // "AUTHORIZED_PARTIES": "http://localhost:5173,https://chat.example.com"
  "vars": {
    "AUTHORIZED_PARTIES": "http://localhost:5173,https://my-agent.pilkington.workers.dev"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "CHAT_HISTORY",
      "database_name": "chat-history",
      "database_id": "c0141bd5-172b-4481-9e59-eca19fed5e5b",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatAgent",
        "class_name": "ChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatAgent"],
      "deleted_classes": ["CounterAgent"]
    }
  ],
  // When ready for your own domain:
  // "routes": [{ "pattern": "chat.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  }
}
